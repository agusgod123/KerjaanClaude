# Prototipe UI saat ini hanya memakai dua variabel di bawah; sisanya disiapkan
# sesuai PRD untuk fase Fondasi (PostgreSQL, Better Auth, storage, email, push).

# Nama instansi di kop PR cetak. Kosongkan bila belum diputuskan.
ORG_NAME=
# Alamat tetap aplikasi, dipakai di QR verifikasi (mis. https://pr.domain-kantor)
APP_URL=

# --- fase berikutnya ---
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=
STORAGE_DRIVER=s3
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CRON_SECRET=
